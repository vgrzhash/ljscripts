local minimized = false

local function setMinimized(state)
    if minimized == state or not Main.Parent then return end
    minimized = state

    if state then
        if dropdownOpen then
            dropdownOpen = false
            DropdownList.Visible = false
            DropdownList.Size = UDim2.new(1, -PAD*2, 0, 0)
            ExecuteBtn.Position = UDim2.new(0, PAD, 0, EXEC_Y)
            DdArrow.Text = "▼"
        end
        Content.Visible = false
        TweenService:Create(Main, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, PANEL_W, 0, TOPBAR_H)
        }):Play()
        MinBtn.Text = "+"
    else
        TweenService:Create(Main, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, PANEL_W, 0, PANEL_CLOSE)
        }):Play()
        task.wait(0.05)
        if Main.Parent then Content.Visible = true end
        MinBtn.Text = "—"
    end
end

