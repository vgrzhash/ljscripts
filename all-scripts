-- Spawn universal (funciona em qualquer executor)
local function spawnTask(fn)
    local ok = pcall(function() task.spawn(fn) end)
    if not ok then
        pcall(function() spawn(fn) end)
    end
end

ExecuteBtn.MouseButton1Click:Connect(function()
    if not selected then
        setBtn("SELECIONE UM SCRIPT", true)
        task.delay(1.2, function() setBtn("EXECUTAR", false) end)
        return
    end

    if dropdownOpen then closeDropdown() end

    local chosenUrl = urls[selected]
    if not chosenUrl then return end

    setBtn("BAIXANDO...", false)

    -- ⚠️ YIELD aqui: libera o frame pra UI atualizar antes do trabalho pesado
    task.wait(0.08)

    spawnTask(function()
        -- ETAPA 1: baixar o source
        local okHttp, source = pcall(function()
            return game:HttpGet(chosenUrl)
        end)

        if not okHttp or not source then
            setBtn("ERRO AO BAIXAR", true)
            task.delay(2, function() setBtn("EXECUTAR", false) end)
            return
        end

        setBtn("CARREGANDO...", false)
        task.wait(0.05)

        -- ETAPA 2: compilar
        local compileOk, compiled = pcall(function()
            return loadstring(source)
        end)

        if not compileOk or not compiled then
            setBtn("SCRIPT INVÁLIDO", true)
            task.delay(2, function() setBtn("EXECUTAR", false) end)
            return
        end

        setBtn("EXECUTANDO...", false)
        task.wait(0.05)

        -- ETAPA 3: rodar (não espera retorno - hubs têm loop infinito)
        pcall(compiled)

        -- Como o hub fica em loop, o pcall só retorna se der erro antes
        -- então resetamos o botão por tempo fixo
        task.delay(2, function() setBtn("EXECUTAR", false) end)
    end)
end)

