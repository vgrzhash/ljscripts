local function openDropdown()
    if dropdownOpen or not Main.Parent then return end
    dropdownOpen = true
    DropdownList.Visible = true

    TweenService:Create(Main, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, PANEL_W, 0, PANEL_OPEN)
    }):Play()
    TweenService:Create(DropdownList, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(1, -PAD*2, 0, DD_LIST_H)
    }):Play()
    TweenService:Create(ExecuteBtn, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, PAD, 0, EXEC_Y_OPEN)
    }):Play()
    DdArrow.Text = "▲"
end

closeDropdown = function()
    if not dropdownOpen then return end
    dropdownOpen = false
    if not Main.Parent then return end

    TweenService:Create(Main, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, PANEL_W, 0, PANEL_CLOSE)
    }):Play()
    TweenService:Create(DropdownList, TweenInfo.new(0.2), {
        Size = UDim2.new(1, -PAD*2, 0, 0)
    }):Play()
    TweenService:Create(ExecuteBtn, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, PAD, 0, EXEC_Y)
    }):Play()
    DdArrow.Text = "▼"

    task.delay(0.22, function()
        if not dropdownOpen and DropdownList.Parent then
            DropdownList.Visible = false
        end
    end)
end

DropdownBtn.MouseButton1Click:Connect(function()
